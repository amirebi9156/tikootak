# ===== Main settings (fill in before install) =====
# Domain that points to this server's IP. Keep the DNS TTL low (e.g. 300) so moving servers is fast.
DOMAIN=chat.example.ir
# Public IP of this server (required for voice/video calls). Change with: sudo tikootak set-ip
PUBLIC_IP=1.2.3.4

# Site address for Caddy.
# Automatic mode (Let's Encrypt certificate): the same domain, e.g. chat.example.ir
# Manual certificate mode: the same domain + CADDYFILE=./Caddyfile.manual-cert
SITE_ADDRESS=chat.example.ir
CADDYFILE=./Caddyfile

# Server-side channel member privacy (Q7). 1 = on (recommended), 0 = off.
# When on, normal channel members cannot see other members via Matrix member/state/sync APIs.
CHANNEL_PRIVACY=1

# ===== Secrets: leave empty and install.sh generates them =====
POSTGRES_PASSWORD=
SYNAPSE_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET=
SYNAPSE_FORM_SECRET=
LIVEKIT_KEY=
LIVEKIT_SECRET=
GATEWAY_ADMIN_KEY=

# ===== Backups =====
# Backup encryption key; generated automatically if empty. Keep a copy somewhere safe, OFF this server!
BACKUP_PASSPHRASE=
# Automatically copy every backup to another server (SSH key login): user@host:/path
BACKUP_SCP_TARGET=
# If you use restic, put the repository here to also get off-site backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ===== Rate limits (optional) =====
# If several friends share one IP (e.g. mobile data) and get "too many attempts", raise these
# RATE_REGISTER_PER_HOUR=10
# RATE_LOGIN_PER_15MIN=30
# Total file quota per user (MB)
USER_QUOTA_MB=3000

# ===== Video transcoding =====
TRANSCODE=1
# Skip transcoding for videos that are already small (MB)
# TRANSCODE_SKIP_MB=10

# ===== Memory limits (small servers) =====
# SYNAPSE_MEM=700m
# POSTGRES_MEM=300m
# LIVEKIT_MEM=200m
# GATEWAY_MEM=450m
# CADDY_MEM=64m

# ===== Image versions (pinned automatically by ./scripts/pin-images.sh) =====
# CADDY_IMAGE=
# POSTGRES_IMAGE=
# SYNAPSE_IMAGE=
# LIVEKIT_IMAGE=

# ===== Admin security =====
# Only these IPs can reach /api/admin and admin.html (comma separated, CIDR allowed:
# 1.2.3.4,5.6.7.0/24). Empty = anyone with the key (not recommended, but easiest).
# If the admin panel says "IP not allowed", edit or clear this line, then: sudo tikootak restart
# 127.0.0.1 and scripts/admin.sh on the server always work.
# ADMIN_ALLOW_IPS=

# ===== Failure alerts (monitor.sh) =====
# ALERT_WEBHOOK_URL=
# ALERT_BOT_TOKEN=
# ALERT_CHAT_ID=
# ALERT_API_BASE=https://tapi.bale.ai   # for the Bale bot (works inside Iran); default is Telegram

# ===== Restricted networks (optional) =====
# If the server cannot reach Docker Hub / npm / Debian: use a mirror, or build an offline pack (scripts/pack-offline.sh)
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=mirror.example.ir
